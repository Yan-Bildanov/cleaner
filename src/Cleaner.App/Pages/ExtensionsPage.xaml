<Page x:Class="Cleaner.App.Pages.ExtensionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Расширения">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel Margin="28,8,28,24">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ui:TextBlock Text="Расширения браузеров" FontTypography="TitleLarge" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SummaryText" Text="Читаю профили браузеров…" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Button x:Name="RefreshButton" Grid.Column="1" Content="Обновить" VerticalAlignment="Bottom"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Refresh_Click" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SuspiciousOnly" Content="Только с предупреждениями" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <ComboBox x:Name="BrowserBox" Grid.Column="1" Width="220" SelectionChanged="Filter_Changed" />
        </Grid>

        <ui:Card x:Name="StatusCard" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ProgressRing x:Name="StatusRing" IsIndeterminate="True" Width="22" Height="22" Margin="0,0,12,0" />
                <ui:SymbolIcon x:Name="StatusIcon" Symbol="CheckmarkCircle24" FontSize="22" Margin="0,0,12,0" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="StatusText" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ui:Button x:Name="CloseStatusButton" Grid.Column="2" Content="Закрыть" Appearance="Transparent" VerticalAlignment="Center"
                           Click="CloseStatus_Click" />
            </Grid>
        </ui:Card>

        <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Margin="0,40" HorizontalAlignment="Center" />

        <ItemsControl x:Name="ExtList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Description}" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon Symbol="Warning16" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{Binding WarningsText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding NotesText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <ui:Button Grid.Column="2" Content="{Binding ActionText}" Appearance="{Binding ActionAppearance}"
                                       VerticalAlignment="Center" Tag="{Binding}" Click="Action_Click"
                                       IsEnabled="{Binding CanAct}" ToolTip="{Binding ActionTooltip}" ToolTipService.ShowOnDisabled="True" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyText" Margin="8,24" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</Page>
