<Page x:Class="Cleaner.App.Pages.CleanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Очистка">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="28,8,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
            <ui:TextBlock Text="Очистка" FontTypography="TitleLarge" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBlock Text="Отметь, что проверить, и нажми «Анализ». Ничего не удаляется без подтверждения."
                          Appearance="Secondary" Margin="0,4,0,0" />
        </StackPanel>

        <ItemsControl x:Name="GroupsList" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardExpander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8">
                        <ui:CardExpander.Icon>
                            <ui:SymbolIcon Symbol="{Binding Icon}" />
                        </ui:CardExpander.Icon>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                                            <TextBlock Text="{Binding Detail}" Margin="32,-4,0,0" FontSize="12"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Top" Margin="12,6,4,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:Card Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Padding="20">
            <StackPanel>
                <ui:TextBlock x:Name="ResultTitle" Text="Результат анализа" FontTypography="Subtitle" />
                <TextBlock x:Name="TotalText" Text="0 МБ" FontSize="40" FontWeight="SemiBold" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="StatusText" Text="Анализ ещё не запускался" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="Progress" Margin="0,12,0,0" Visibility="Collapsed" />
                <ui:Button x:Name="AnalyzeButton" Content="Анализ" Appearance="Primary" HorizontalAlignment="Stretch"
                           Icon="{ui:SymbolIcon Search24}" Margin="0,16,0,8" Click="Analyze_Click" />
                <ui:Button x:Name="CleanButton" Content="Очистить" HorizontalAlignment="Stretch"
                           Icon="{ui:SymbolIcon Delete24}" IsEnabled="False" Click="Clean_Click"
                           ToolTipService.ShowOnDisabled="True" ToolTip="Сначала нажми «Анализ»" />
                <CheckBox x:Name="RestorePointCheck" Content="Создать точку восстановления" Margin="0,16,0,0"
                          ToolTip="Перед очисткой создать точку восстановления Windows (нужны права администратора)" />
                <ui:Button x:Name="AdminButton" Content="Права администратора" HorizontalAlignment="Stretch"
                           Icon="{ui:SymbolIcon Shield24}" Margin="0,12,0,0" Click="Admin_Click"
                           ToolTip="Нужно для системных временных файлов, загрузок Центра обновления и точки восстановления" />
                <ui:HyperlinkButton x:Name="QuarantineLink" Content="Карантин" Margin="-12,8,0,0" Click="Quarantine_Click" />
            </StackPanel>
        </ui:Card>
    </Grid>
</Page>
