<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Cleaner.Core\Cleaner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Cleaner</AssemblyName>
    <RootNamespace>Cleaner.App</RootNamespace>
    <!-- Windows 10 2004+: нужны API пакетов Microsoft Store (Windows.Management.Deployment). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Только для значка в трее с уведомлением после автоочистки (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\cleaner.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>Cleaner</Product>
  </PropertyGroup>

  <!-- Финальная сборка: один самодостаточный .exe (не нужен установленный .NET). tools\install.ps1 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\cleaner.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms подключён ради одного NotifyIcon — его пространства имён не должны конфликтовать с WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
